{
  "$schema": "https://www.getbifrost.ai/schema",

  "client": {
    "drop_excess_requests": false,
    "prometheus_labels": ["model", "provider"]
  },

  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },

  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    }
  },

  "mcp": {
    "tool_manager_config": {
      "disable_auto_tool_inject": true
    },
    "client_configs": [
      {
        "name": "mcpproxy",
        "connection_type": "http",
        "connection_string": "http://172.19.0.1:3130/mcp",
        "is_ping_available": false,
        "auth_type": "headers",
        "headers": {
          "Authorization": "Bearer {{ op://clankers/mcpproxy-agents/password }}"
        },
        "tools_to_execute": ["*"],
        "tools_to_auto_execute": [
          "exa__web_search_exa",
          "exa__web_search_advanced_exa",
          "exa__web_fetch_exa"
        ],
        "allow_on_all_virtual_keys": false
      }
    ]
  },

  "governance": {
    "pricing_overrides": [
      {
        "id": "ollama-provider-zero-cost",
        "name": "Ollama Provider Zero Cost",
        "scope_kind": "provider",
        "provider_id": "ollama",
        "match_type": "wildcard",
        "pattern": "*",
        "request_types": ["chat_completion", "text_completion", "responses", "embedding"],
        "pricing_patch": "{\"input_cost_per_token\":0,\"output_cost_per_token\":0}"
      }
    ]
  },

  "plugins": [
    {
      "enabled": true,
      "name": "model-policy-suffix",
      "path": "/app/plugins/model-policy-suffix.so",
      "version": 1
    },
    {
      "enabled": true,
      "name": "embedding-task-prefix",
      "path": "/app/plugins/embedding-task-prefix.so",
      "version": 1,
      "config": {
        "strip_input_type": true,
        "rules": [
          {
            "name": "ollama-nomic-embed-text",
            "provider": "ollama",
            "model_prefix": "nomic-embed-text",
            "prefixes": {
              "query": "search_query: ",
              "document": "search_document: "
            }
          }
        ]
      }
    }
  ],

  "providers": {
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-key-1",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://openrouter.ai/api",
        "default_request_timeout_in_seconds": 600
      }
    },

    "anthropic": {
      "keys": [
        {
          "name": "anthropic-key-1",
          "value": "env.ANTHROPIC_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },

    "opencode-zen": {
      "keys": [
        {
          "name": "opencode-zen-key-1",
          "value": "env.OPENCODE_ZEN_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },

    "openai": {
      "keys": [
        {
          "name": "openai-key-1",
          "value": "env.OPENAI_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },

    "codex": {
      "keys": [
        {
          "name": "codex-oauth-noauth",
          "value": "env.CODEX_PROXY_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://codex-oauth:10531",
        "default_request_timeout_in_seconds": 600,
        "stream_idle_timeout_in_seconds": 300,
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        }
      }
    },

    "nvidia": {
      "keys": [
        {
          "name": "nvidia-build-key-1",
          "value": "env.NVIDIA_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://integrate.api.nvidia.com",
        "default_request_timeout_in_seconds": 120
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "embedding": true
        }
      }
    },

    "deepseek": {
      "keys": [
        {
          "name": "deepseek-key-1",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.deepseek.com",
        "default_request_timeout_in_seconds": 120
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    },

    "nanogpt": {
      "keys": [
        {
          "name": "nanogpt-key-1",
          "value": "env.NANOGPT_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://nano-gpt.com/api",
        "default_request_timeout_in_seconds": 600,
        "stream_idle_timeout_in_seconds": 300
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "text_completion": true,
          "text_completion_stream": true,
          "embedding": true
        }
      }
    },

    "unsloth": {
      "keys": [
        {
          "name": "unsloth-studio-key-1",
          "value": "env.UNSLOTH_STUDIO_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://unsloth.win.ankitson.com",
        "default_request_timeout_in_seconds": 600,
        "stream_idle_timeout_in_seconds": 300,
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "text_completion": true,
          "text_completion_stream": true,
          "responses": true,
          "responses_stream": true,
          "embedding": true
        }
      }
    },

    "ollama": {
      "keys": [
        {
          "name": "ollama-local",
          "value": "",
          "models": ["*"],
          "weight": 1.0,
          "ollama_key_config": {
            "url": "env.OLLAMA_URL"
          }
        }
      ],
      "network_config": {
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 120
      }
    },

    "speaches": {
      "keys": [
        {
          "name": "speaches-noauth",
          "value": "env.SPEACHES_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://speaches:8000",
        "default_request_timeout_in_seconds": 120,
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "transcription": true,
          "transcription_stream": true,
          "speech": true
        }
      }
    },

    "audiocpp": {
      "keys": [
        {
          "name": "audiocpp-noauth",
          "value": "env.AUDIOCPP_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://audiocpp:8080",
        "default_request_timeout_in_seconds": 300,
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "transcription": true,
          "transcription_stream": true,
          "speech": true
        }
      }
    },

    "nemotron-asr": {
      "keys": [
        {
          "name": "nemotron-noauth",
          "value": "env.NEMOTRON_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://nemotron-asr:8000",
        "default_request_timeout_in_seconds": 300,
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "transcription": true
        }
      }
    }
  }
}

        "bifrost/deepseek/deepseek-v4-pro": {},
        "bifrost/anthropic/claude-opus-4-8": {}
      },
      "thinkingDefault": "medium"
    },
    "list": [
      { "id": "main", "workspace": "/cybernetics/agents/main", "default": true, "thinkingDefault": "medium" },
      { "id": "gilfoyle", "name": "gilfoyle", "workspace": "/cybernetics/agents/gilfoyle", "thinkingDefault": "medium" },
      { "id": "austin", "name": "austin", "workspace": "/cybernetics/agents/austin", "thinkingDefault": "medium" }
    ]
  },
  "tools": {
    "sessions": {
      "visibility": "all"
    },
    "agentToAgent": {
      "enabled": true,
      "allow": ["main", "gilfoyle", "austin"]
    }
  },
  "bindings": [
    { "match": { "channel": "discord", "peer": { "kind": "channel", "id": "1513643336161034402" } }, "agentId": "gilfoyle" },
    { "match": { "channel": "discord", "peer": { "kind": "channel", "id": "1514931682720088105" } }, "agentId": "austin" }
  ],
  "channels": {
    "discord": {
      "thread": { "inheritParent": false },
      "guilds": {
        "911234218556796938": {
          "channels": {
            "1513643336161034402": { "requireMention": false },
            "1514931682720088105": { "requireMention": false }
          }
        }
      }
    }
  },
  "auth": {
    "order": {
      "openai": ["openai:{{ op://clankers/codex/username }}", "openai:default"]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "opencode": null,
      "bifrost": {
        "baseUrl": "http://bifrost:8080/openai/v1",
        "apiKey": "none",
        "api": "openai-completions",
        "contextWindow": 200000,
        "models": [
          { "id": "codex/gpt-5.3-codex-spark", "name": "Bifrost · gpt-5.3-codex-spark (ChatGPT sub)", "reasoning": true },

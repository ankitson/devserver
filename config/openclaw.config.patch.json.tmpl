      "memorySearch": {
        "provider": "openai-compatible",
        "model": "unsloth/Qwen/Qwen3-Embedding-8B-GGUF",
        "queryInputType": "query",
        "documentInputType": "document",
        "fallback": "none",
        "remote": {
          "baseUrl": "http://bifrost:8080/openai/v1",
          "headers": {
            "x-bf-passthrough-extra-params": "true"
          }

{
  "mcp": {
    "servers": {
      "mcpproxy": {
        "transport": "streamable-http",
        "url": "https://mcp.dev.ankitson.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ op://clankers/mcpproxy-agents/password }}"
        }
      }

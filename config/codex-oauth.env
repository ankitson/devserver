# Proxy logging defaults for codex-oauth
PROXY_LOG_LEVEL=debug
PROXY_VERBOSE=1
# Explicit model list — the openai-oauth package may not know about 5.6 yet.
MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.5,gpt-5.3-codex-spark,codex-auto-review,gpt-5.6-luna,gpt-5.6-luna-pro,gpt-5.6-sol,gpt-5.6-sol-pro,gpt-5.6-terra,gpt-5.6-terra-pro

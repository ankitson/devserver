# Bifrost LLM gateway — provider API keys.
# Rendered to secrets/bifrost.env by `just rs` (op inject). config/bifrost.config.json
# references these by name as `env.OPENROUTER_API_KEY` etc.
OPENROUTER_API_KEY={{ op://clankers/openrouter/password }}
ANTHROPIC_API_KEY={{ op://clankers/anthropic-key1/password }}
OPENAI_API_KEY={{ op://clankers/openai/password }}
NVIDIA_API_KEY={{ op://clankers/nvidia-build/password }}
DEEPSEEK_API_KEY={{ op://clankers/deepseek/password }}
NANOGPT_API_KEY={{ op://clankers/nanogpt/password }}
UNSLOTH_STUDIO_API_KEY={{ op://clankers/llm-windows/password }}
OLLAMA_URL=https://ollama.dev.ankitson.com
# speaches (local Whisper) needs no auth; Bifrost still requires a key entry.
SPEACHES_API_KEY=none
# audiocpp (local ggml TTS/STT) needs no auth; Bifrost still requires a key entry.
AUDIOCPP_API_KEY=none
# nemotron-asr (local NeMo Nemotron 3.5 ASR) needs no auth; Bifrost still requires a key entry.
NEMOTRON_API_KEY=none
# parakeet-asr (local onnx-asr Parakeet TDT v2) needs no auth; Bifrost still requires a key entry.
PARAKEET_API_KEY=none
# codex-oauth proxy needs no auth (internal, mybridge-only); Bifrost still requires a key entry.
CODEX_PROXY_API_KEY=none
# opencode-zen — deepseek-v4-flash-free etc. served by the opencode-zen API
OPENCODE_ZEN_API_KEY={{ op://clankers/opencode-zen/password }}
